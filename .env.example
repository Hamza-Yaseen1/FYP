# ── Frontend environment variables ─────────────────────────────────────────
# Copy this file to `.env.local` and adjust the values. `.env.local` is
# git-ignored and must never be committed with real credentials.
#
# Only `NEXT_PUBLIC_*` variables are exposed to the browser. Never put API
# keys, passwords, or tokens in a `NEXT_PUBLIC_` variable.

# Backend origin used by the Next.js rewrite (`/api/:path*` -> `<BACKEND_URL>/:path*`)
# and by the server-side `/api/auth/logout` route. This is the ONE value to
# change when pointing the frontend at a different backend.
BACKEND_URL=https://fyp-omega-peach.vercel.app

# Browser-facing API prefix. Keep the relative `/api` value so requests stay
# same-origin, are proxied through Next.js, and send the httpOnly session
# cookie. Only use an absolute URL if the backend supports credentialed CORS
# (CORS allow-list + SameSite=None; Secure cookies).
NEXT_PUBLIC_API_BASE=/api

# Optional: direct WebSocket URL for live updates. Next.js rewrites do not
# proxy WebSockets, so this must point at the backend itself.
# NEXT_PUBLIC_WS_URL=wss://fyp-omega-peach.vercel.app/ws

# Optional: enable the short-lived `?token=` WebSocket handshake fallback
# (defaults to true in `next dev`, false in production). Requires the backend
# to set WS_ALLOW_QUERY_TOKEN=true.
# NEXT_PUBLIC_WS_USE_TOKEN=false
